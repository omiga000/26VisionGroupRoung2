  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Scau_Work\Taurus\26VisionGroupRound2\build && D:\My_Compiler\Msys2\ucrt64\bin\cmake.exe --regenerate-during-build -SD:\Scau_Work\Taurus\26VisionGroupRound2 -BD:\Scau_Work\Taurus\26VisionGroupRound2\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

